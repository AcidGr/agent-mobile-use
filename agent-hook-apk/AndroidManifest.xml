<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.agent.mobileuse"
    android:versionCode="5"
    android:versionName="3.2">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:label="DeepSeek Agent"
        android:icon="@drawable/dsh_whale_icon"
        android:usesCleartextTraffic="true"
        android:hasCode="true">

        <service
            android:name="com.agent.mobileuse.GlowService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.agent.mobileuse.ACTION_GLOW" />
            </intent-filter>
        </service>

        <service
            android:name="com.agent.mobileuse.NotifyService"
            android:exported="true" />

        <activity
            android:name=".QuestionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTop"
            android:taskAffinity="com.agent.mobileuse.question"
            android:excludeFromRecents="true"
            android:exported="true" />

        <activity
            android:name=".DemoDialogActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTop"
            android:taskAffinity="com.agent.mobileuse.overlay"
            android:excludeFromRecents="true"
            android:exported="true" />

        <receiver
            android:name=".QuestionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.agent.mobileuse.ACTION_QUESTION" />
                <action android:name="com.agent.mobileuse.ACTION_QUESTION_CANCEL" />
                <action android:name="com.agent.mobileuse.ACTION_QUESTION_DIRECT_ANSWER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".NotifyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.agent.mobileuse.ACTION_NOTIFY" />
                <action android:name="com.agent.mobileuse.ACTION_CLEAR" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Agent Mobile Use Display &amp; IME Isolation Hook" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
    </application>
</manifest>
